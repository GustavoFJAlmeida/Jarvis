# Copie este arquivo e renomeie a cópia para .env (sem "exemplo")
# NUNCA envie o .env para o GitHub.

# Qual cérebro usar: ollama (grátis, no seu PC) ou claude (API paga)
CEREBRO=ollama

# Modelo do Ollama (baixe antes com: ollama pull qwen2.5:7b)
OLLAMA_MODELO=qwen2.5:7b

# Só se for usar a API do Claude
ANTHROPIC_API_KEY=cole-sua-chave-aqui
CLAUDE_MODELO=claude-haiku-5-5

# Cidade usada quando você não diz qual
CIDADE_PADRAO=São José dos Campos
